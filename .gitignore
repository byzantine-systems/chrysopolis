# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# ---
# Zig
# ---
.zig-cache/
zig-out/
*.o

# Keep the root Zig build's imported helpers under build/. Ignore generated
# build products while retaining the checked-in Zig source modules.
/build/*
!/build/
!/build/*.zig

# ---
# BEAM Project artifacts
# ---
# rebar3's output tree for tests/ (see rebar.config). /ebin is where
# `rebar3 bare compile` lands, which is the form the Nix build uses.
/_build/
/ebin/

# ---
# Nix
# ---
/result*
.devenv*
.direnv/

# -----
# Misc.
# -----
.env

## QEMU stuff
*.img
