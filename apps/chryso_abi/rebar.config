%% The orchestration ABI codec (chryso_abi_codec) and its header are generated
%% by tools/abi and never committed; rebar.config.script copies them in from
%% $CHRYSO_ABI_GENERATED. Run `rebar3 as test nix lock -o rebar-deps.nix` after
%% changing deps: Nix builds from that file, never from Hex at build time.
{erl_opts, [
    warnings_as_errors,
    warn_missing_spec,
    %% Exported functions and types carry -doc Markdown (EEP-59); a gap fails the build.
    warn_missing_doc,
    warn_unused_import,
    debug_info
]}.

{deps, []}.

{plugins, [
    {rebar3_nix, ".*", {git, "https://github.com/erlang-nix/rebar3_nix.git", {tag, "v0.1.1"}}}
]}.

{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]}
    ]}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, no_unknown]},
    {plt_apps, top_level_deps}
]}.
