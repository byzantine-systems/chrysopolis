{application, chryso_core, [
    {description, "Chrysopolis orchestration semantics"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [kernel, stdlib]},
    {env, []},
    {licenses, ["Apache-2.0"]}
]}.
