--- a/drivers/network/virtio/common/ethernet.c
+++ b/drivers/network/virtio/common/ethernet.c
@@ -297,6 +297,11 @@
 {
     assert(virtio_transport_probe(&device_resources, &dev, VIRTIO_DEVICE_ID_NET));
 
+    /* Chrysopolis (driver restart): the used-ring cursor resets and the
+     * virtqueue zeroing happen further down, after the in-flight buffer
+     * reclaim, because the reclaim depends on both still holding their
+     * pre-crash values. See the reclaim block below. */
+
     // Do normal device initialisation (section 3.2)
 
     // First reset the device
@@ -371,9 +376,121 @@
 
     assert(virtq_size + tx_headers_size + rx_headers_size <= HW_RING_SIZE);
 
+    /*
+     * Chrysopolis (driver restart): hand back the buffers the dead instance was
+     * still holding.
+     *
+     * This block is ordered the way it is out of necessity. It must run AFTER
+     * the virtq pointers above are assigned (it reads descriptors through them)
+     * but BEFORE the ialloc_init pair just below, which destroys the very state
+     * that says which buffers were in flight.
+     *
+     * Why reclaim at all: every buffer referenced by a live descriptor was
+     * dequeued from the sDDF free queue and is, as far as the virtualiser is
+     * concerned, checked out to this driver. rx_provide() spends TWO descriptors
+     * per buffer and the in-flight cap is virtio_avail_full(), i.e.
+     * rx_ialloc_desc.size >= rx_virtq.num, so up to half the 512-buffer pool can
+     * be outstanding. Dropping them on the floor loses half the pool per
+     * restart: the second restart exhausts it and RX stops for good, well inside
+     * the fault handler's restart budget. So this is a correctness requirement,
+     * not an optimisation.
+     *
+     * Why the walk is driven by the ALLOCATOR and not by scanning descriptor
+     * flags: a freed descriptor keeps its stale contents, so a flag scan would
+     * re-enqueue buffers rx_return() had already handed back, putting the same
+     * address into the free pool twice. Two descriptors pointing at one buffer
+     * is silent packet corruption, which is strictly worse than the leak this
+     * fixes. ialloc's state lives in .bss and therefore survives, so it is the
+     * only trustworthy record of what was live.
+     *
+     * Bounding the walk by ia->capacity rather than a compile-time constant is
+     * what makes the cold-boot case need no special handling: capacity is .bss
+     * zero until ialloc_init runs, so on a cold boot both loops run zero times.
+     * It is also the correct bound now that 0.7.0 negotiates queue size with the
+     * host instead of hard-coding it.
+     *
+     * sDDF 0.7.0 made ialloc_in_use() exact, so the tail of the free list no
+     * longer reads as in use and the hand-written guard this block used to carry
+     * has been dropped. See the same note in the blk virtualiser's sweep.
+     */
+    unsigned int reclaimed_rx = 0;
+    unsigned int reclaimed_tx = 0;
+    for (int dir = 0; dir < 2; dir++) {
+        ialloc_t *ia = (dir == 0) ? &rx_ialloc_desc : &tx_ialloc_desc;
+        struct virtq *vq = (dir == 0) ? &rx_virtq : &tx_virtq;
+        net_queue_handle_t *q = (dir == 0) ? &rx_queue : &tx_queue;
+        unsigned int *count = (dir == 0) ? &reclaimed_rx : &reclaimed_tx;
+
+        for (uint32_t id = 0; id < ia->capacity; id++) {
+            if (!ialloc_in_use(ia, id)) {
+                continue;
+            }
+            /* Act only on HEADER descriptors. Each buffer owns two descriptor
+             * ids, header and packet, allocated separately, and the header is
+             * the one that names the packet through .next. Skipping non-headers
+             * is what stops each buffer being counted twice. The length check is
+             * the same signature rx_return() relies on, and it also bounds the
+             * torn-pair case: a crash inside rx_provide() can leave a header
+             * written with its packet half not yet filled in, and such a pair is
+             * skipped here, leaking at most one buffer per crash. */
+            if (!(vq->desc[id].flags & VIRTQ_DESC_F_NEXT)) {
+                continue;
+            }
+            if (vq->desc[id].len != sizeof(virtio_net_hdr_t)) {
+                continue;
+            }
+            uint16_t pkt_idx = vq->desc[id].next % vq->num;
+            net_buff_desc_t buffer = { vq->desc[pkt_idx].addr, 0 };
+            /* Both directions return to the FREE queue: rx buffers came from the
+             * rx free queue, and tx_return() is what would ordinarily have put
+             * the tx buffer back on the tx free queue. */
+            if (net_enqueue_free(q, buffer) == 0) {
+                (*count)++;
+            }
+        }
+    }
+    sddf_dprintf("ETH|restart|reclaimed|rx=%u|tx=%u\n", reclaimed_rx, reclaimed_tx);
+
     ialloc_init(&rx_ialloc_desc, rx_descriptors, rx_q_driver_capacity);
     ialloc_init(&tx_ialloc_desc, tx_descriptors, tx_q_driver_capacity);
 
+    /* Chrysopolis (driver restart): the used-ring cursors. A warm restart does
+     * not re-zero .bss and these live in the global virtq structs, so without
+     * this they hold their pre-crash values while the device reset above rewound
+     * the device to index 0: rx_return()/tx_return() would scan from the middle
+     * of the used ring and treat never-completed descriptors as complete. The
+     * descriptor high-water marks that used to be reset alongside these are gone
+     * as of sDDF 0.7.0, which derives fullness from the allocator instead
+     * (virtio_avail_full reads ia->size), so ialloc_init above already covers
+     * them. */
+    rx_virtq.used_head = 0;
+    tx_virtq.used_head = 0;
+
+    /* Chrysopolis (driver restart): zero the virtqueue metadata, for the same
+     * reason the virtio block driver does. The descriptor tables and avail/used
+     * rings live in the shared hw_ring_buffer region and survive a restart,
+     * while the device reset above rewound the device's own cursors.
+     * rx_provide()/tx_provide() just below publish buffers by writing
+     * avail->ring[avail->idx % num] and incrementing avail->idx, so a stale
+     * avail->idx would make the freshly reset device believe a full ring of
+     * buffers is already available and consume descriptors describing buffers
+     * that no longer belong to this instance.
+     *
+     * On a cold boot the region arrives zeroed from the Microkit loader, which
+     * is why this only bites on restart. Exactly the ring span [0, virtq_size)
+     * is cleared; the packet headers that follow are rewritten per descriptor by
+     * rx_provide()/tx_provide().
+     *
+     * The trailing barrier matters here in a way it does not for the block
+     * driver: as of sDDF 0.7.0 hw_ring_buffer is a CACHED mapping
+     * (drivers/network/virtio/mmio/config.json), so these stores must be pushed
+     * out before the device is handed the rings, the same ordering requirement
+     * that put a wwmb() before every avail->idx increment. Upstream candidate. */
+    for (size_t i = 0; i < virtq_size; i++) {
+        ((volatile uint8_t *)hw_ring_buffer_vaddr)[i] = 0;
+    }
+    wwmb();
+
     rx_provide();
     tx_provide();
 
