+/* START_CHRYSOPOLIS_MODIFICATION: write the window back and flush. A caching
+ * disk may persist writes between flushes in any order. */
+static FRESULT barrier (	/* Returns FR_OK or FR_DISK_ERR */
+	FATFS* fs		/* Filesystem object */
+)
+{
+	FRESULT res = sync_window(fs);
+
+	if (res == FR_OK && disk_ioctl(fs->pdrv, CTRL_SYNC, 0) != RES_OK) res = FR_DISK_ERR;
+	return res;
+}
+/* END_CHRYSOPOLIS_MODIFICATION */
+
