%% Build definition for the console-driving probes in tests/.
%%
%% This exists for the TOOLING as much as for the build. It is what the
%% erlang-language-platform (ELP, in the devenv shell) discovers to resolve
%% calls ACROSS the probe modules, which is most of what they do: every
%% chryso_* module calls chryso_test:emit/2 and chryso_test:tag/1. Without a
%% project model ELP treats each file as standalone and those calls go
%% unchecked, which would forfeit most of the reason the Erlang was moved out
%% of the Python string literals in tests.nix. It also makes `rebar3 dialyzer`
%% and `rebar3 xref` available with no further setup.
%%
%% src_dirs is tests/ rather than the rebar3 default src/, because src/ in this
%% repo is the Gleam application and the C runtime adapter, not Erlang. It is
%% also deliberately NOT test/, which is Gleam's own convention and would be
%% claimed by the Gleam build (gleam.toml sits at this same root).
{src_dirs, ["tests"]}.

%% warnings_as_errors: a warning in a probe is a bug in the probe, and the
%%   whole point of this migration is that it fails at build time rather than
%%   as a wait_console timeout minutes into a QEMU boot.
%% warn_missing_spec: tests.nix calls these by name and arity from Python, so
%%   the spec is the contract it codes against.
%% debug_info: a few KB on a 96M volume, and it is what dialyzer needs.
%%
%% `deterministic` is deliberately absent: beamPackages.buildRebar3 injects it
%% through ERL_COMPILER_OPTIONS for every build it drives (its
%% erlangDeterministicBuilds argument defaults to true), so setting it here as
%% well would only be a second place to keep in sync.
{erl_opts, [
    warnings_as_errors,
    warn_missing_spec,
    warn_unused_import,
    debug_info
]}.
